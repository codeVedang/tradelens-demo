# Backend only. Never use a VITE_ prefix for secrets.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=data/coach.sqlite
AI_TIMEOUT_MS=60000
AI_REQUEST_BUDGET=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact override. Defaults to FRONTEND_ORIGIN plus /api/auth/google/callback.
GOOGLE_CALLBACK_URL=
ENABLE_DEMO_LOGIN=false
# One currency for the entire database. Set before first startup.
REPORTING_CURRENCY=INR
PREMIUM_PRICE_LABEL=
PREMIUM_BILLING_PERIOD=
# Optional temporary Premium access for verified Google test accounts.
# Comma-separated emails and an ISO UTC expiry are both required to enable it.
PREMIUM_TEST_EMAILS=
PREMIUM_TEST_UNTIL=
AI_ANALYSIS_INTERVAL_SECONDS=5
CAPTURE_INTERVAL_SECONDS=1
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_RETRIES=1
AI_IMAGE_DETAIL=auto
# Optional; set only to an effort supported by your chosen model.
AI_REASONING_EFFORT=
# local binds to loopback. hosted_demo requires HTTPS and mock AI. production requires HTTPS.
DEPLOYMENT_MODE=local
DEMO_EPHEMERAL_STORAGE=false
